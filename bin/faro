#!/usr/bin/env python3
"""bin/faro · observatory beacon: direct voice proof and app-with-source proof, apart, with cause and time.

Targets come from the environment only (no address is written in the repo):
  PRECEPTOROS_HEXELION_ENDPOINT  the voice station (loopback)
  PRECEPTOROS_FARO_APP           the app face (loopback), e.g. the preview the Sovereign looks at
Usage: bin/faro "a question the house memory can cite"
"""
import datetime
import json
import os
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
import faro  # noqa: E402

if __name__ == "__main__":
    question = " ".join(sys.argv[1:]).strip() or "LoRA v7 servido en Ollama"
    frame = faro.faro(question, app=os.environ.get("PRECEPTOROS_FARO_APP"),
                      fecha=datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
    print(json.dumps(frame, ensure_ascii=False, indent=1))
