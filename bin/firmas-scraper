#!/usr/bin/env python3
"""firmas-scraper · internal agent: reads every open front and writes the pending-signature card.

Runs from a user timer (preceptoros-firmas.timer, every 10 min) or by hand. Read only on
GitHub (`gh pr list`, `gh api` GET); it never comments, merges or signs. Output:
~/.preceptoros/firmas/pendientes.json, written atomically. A failed repo is a NO_DATA cause,
never a silent gap.
"""
import datetime, json, os, subprocess, sys, tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import firmas_pendientes as F  # noqa: E402

DUENO = "piskyRpapalo"
REPOS = ("PreceptorOS", "preceptoros-web", "roadmap", "p0x", "firmas", "lab")
CAMPOS = "number,title,url,headRefOid,headRefName,baseRefName,isDraft,statusCheckRollup,updatedAt"
SALIDA = Path(os.environ.get("PRECEPTOROS_FIRMAS", Path.home() / ".preceptoros" / "firmas" / "pendientes.json"))


def gh(*args):
    r = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=60)
    if r.returncode:
        raise RuntimeError((r.stderr or "gh failed").strip().splitlines()[-1][:120])
    # --paginate with -q prints one JSON document per page: read them all and join the lists.
    texto, dec, docs, i = r.stdout or "null", json.JSONDecoder(), [], 0
    while i < len(texto):
        if texto[i].isspace():
            i += 1
            continue
        doc, i = dec.raw_decode(texto, i)
        docs.append(doc)
    if len(docs) > 1 and all(isinstance(d, list) for d in docs):
        return [x for d in docs for x in d]
    return docs[0] if docs else None


def main():
    ahora = datetime.datetime.now(datetime.timezone.utc)
    hoy, causas, prs = ahora.date().isoformat(), {}, {}
    for nombre in REPOS:
        repo = DUENO + "/" + nombre
        try:
            prs[repo] = gh("pr", "list", "-R", repo, "--state", "open", "-L", "50", "--json", CAMPOS)
        except Exception as e:  # noqa: BLE001 - one repo down is a cause, not a crash
            causas[repo] = "gh_unreadable"
            print("NO_DATA", repo, e, file=sys.stderr)
    desde = (ahora - datetime.timedelta(days=21)).strftime("%Y-%m-%dT%H:%M:%SZ")
    try:
        comentarios = gh("api", "--paginate", "repos/%s/buzon/issues/30/comments?since=%s&per_page=100" % (DUENO, desde),
                         "-q", "[.[] | {body}]")
    except Exception as e:  # noqa: BLE001
        comentarios, causas["buzon#30"] = [], "gh_unreadable"
        print("NO_DATA buzon#30", e, file=sys.stderr)
    doc = F.documento(prs, comentarios, hoy, ahora.strftime("%Y-%m-%dT%H:%M:%SZ"), causas)
    SALIDA.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=SALIDA.parent, prefix=".pendientes-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False, indent=1)
    os.replace(tmp, SALIDA)
    print("firmas:", doc["cuenta"], "no_data:", len(doc["no_data"]))


if __name__ == "__main__":
    main()
