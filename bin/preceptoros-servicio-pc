#!/usr/bin/env bash
# Crea un servicio systemd user para que preceptoros arranque al login

set -euo pipefail

SERVICE_DIR="$HOME/.config/systemd/user"
SERVICE_FILE="$SERVICE_DIR/preceptoros.service"

mkdir -p "$SERVICE_DIR"

cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Preceptor Brain Service
After=network.target

[Service]
Type=simple
WorkingDirectory=$PWD
ExecStart=$PWD/bin/preceptoros-servicio
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
EOF

systemctl --user daemon-reload
systemctl --user enable preceptoros.service
systemctl --user start preceptoros.service

echo "✓ Servicio systemd creado y arrancado"
echo "  Verifica: systemctl --user status preceptoros.service"
echo "  Logs: journalctl --user -u preceptoros.service -f"
