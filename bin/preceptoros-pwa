#!/usr/bin/env python3
"""preceptoros-pwa · la cara premium, y los tres endpoints que necesita.

sistema: solo biblioteca estándar. Sin dependencias.

POR QUÉ EXISTE, Y POR QUÉ SIGUE FUERA DEL PRODUCTO
---------------------------------------------------
La cara de `cara.py` se abre con doble clic y no habla con nadie: esa es su
gracia. Pero un chat de verdad necesita ida y vuelta, y eso pide que algo
escuche. Igual que `preceptoros-puente`, esto **vive en `bin/`, se arranca a mano,
y ningún módulo del producto lo importa**. Un clon que lo tenga no lo ejecuta.

LOS TRES ENDPOINTS, Y LA REGLA QUE COMPARTEN
--------------------------------------------
* `POST /api/frontera` · pasa el texto por el filtro y devuelve el payload
  entero. **La interfaz nunca cuenta.** Los contadores que pinta salen de
  `hallazgos`, tal como los devolvió `guardrails.preparar_envio`.
* `POST /api/charla`   · un turno. Devuelve el texto y el id del turno.
* `GET/POST /api/captura` · listar turnos, consentir y revocar de uno en uno.

Y la que gobierna las tres: **si el filtro no puede terminar, no hay envío.**
`EnvioBloqueado` sale como 409 y la interfaz apaga el botón. No hay ruta que
mande texto sin filtro; no es una opción escondida, es que no existe.

LO QUE NO HACE
--------------
* No escucha fuera de esta máquina salvo que se le diga por variable de
  entorno, nunca por un valor escrito en el repo.
* No consiente por nadie. `consent` lo sube una petición explícita, una por
  turno, y se puede bajar igual.
"""
from __future__ import annotations

import json
import os
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

AQUI = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, AQUI)

import metricas as MET

import memory as M                                          # noqa: E402
import guardrails as G                                      # noqa: E402
import huella as _huella                                    # noqa: E402
import afinado as _afinado                                  # noqa: E402
import casa as _casa                                        # noqa: E402
import captura as C
import proyectos as PR                                         # noqa: E402
import conversacion as _charla                              # noqa: E402
import cara as _cara                                        # noqa: E402
import casa as _casa
import version as _version
import voz as _voz                                        # noqa: E402

BIND = os.environ.get("PRECEPTOROS_PWA_BIND") or os.environ.get("AURELIUS_PWA_BIND", "127.0.0.1")
PUERTO = int(os.environ.get("PRECEPTOROS_PWA_PUERTO") or os.environ.get("AURELIUS_PWA_PUERTO", "8740"))
LIMITE = 512 * 1024
INTERFAZ = os.path.join(AQUI, "interface")

# Los campos del perfil que la interfaz puede tocar. El perfil tiene claves que
# pone el producto y que una peticion no debe poder escribir, asi que esto es
# una lista blanca y no una exclusion.
# `captura` entra el 2026-09-04: el cuaderno pasa de rotulo a interruptor, y
# para que la persona pueda apagarlo tiene que poder viajar por esta puerta.
# `captura.activa()` ya lo leia del perfil desde el principio -- lo que faltaba
# era la forma de escribirlo.
CAMPOS_PERFIL = ("name", "language", "intereses", "instrucciones", "avatar",
                 "captura", "personalizada")

# Vocabulario cerrado de caras, en DOS familias. Lo que se guarde acaba en el
# `src` de una imagen, asi que no puede ser texto libre: con texto libre, la
# interfaz le pediria al servidor la ruta que le hubieran mandado.
#
# Dos familias y no una lista de dieciseis, porque no son lo mismo:
#   bustos · quien eres. El orden es el de la tira que anima el tablero, para
#            que la cara elegida y la que despierta se lean como el mismo
#            personaje.
#   ojos   · la cara que el cabezal se pone segun con quien hablas. Cuatro
#            colores y cuatro con simbolo.
#
# Los ojos entran el 2026-09-02, y no por ampliar: llevaban en `assets/` desde
# que se sincronizo la marca, 51 790 B, y NADIE los referenciaba en todo el
# arbol. Arte pagado y nunca ensenado. La mision pedia elegir «entre los
# sprites de ojos/bustos» y solo se habian entregado los bustos.
FAMILIAS_AVATAR = {
    "bustos": ("busto-dormido.webp", "busto-grieta.webp", "busto-rompe.webp",
               "busto-ojo.webp", "busto-halo.webp", "busto-despierto.webp",
               "busto-corazon.webp", "busto-oscuro.webp"),
    "ojos": ("ojo-ambar.webp", "ojo-azul.webp", "ojo-rojo.webp",
             "ojo-verde.webp", "ojo-birrete.webp", "ojo-bombilla.webp",
             "ojo-cerebro.webp", "ojo-libro.webp"),
}
# La lista plana existe solo para VALIDAR. La interfaz recibe las familias.
AVATARES = tuple(n for f in FAMILIAS_AVATAR.values() for n in f)


# El vocabulario cerrado del selector de cerebro. Constante del producto, no
# estado de una peticion: por eso vive aqui y no como atributo de la clase.
CEREBROS = ("base", "afinado")


def _ruta_visible(ruta):
    """Una ruta que se puede ensenar. Vivia dentro de `_estado` y ahora la
    comparten dos puertas: si la regla cambiara en un sitio y no en el otro,
    una de las dos escupiria el nombre de la persona en su propio tablero.

    `HOME_PATH` es una politica de redaccion activa de este producto, asi que
    su tablero no puede saltarsela. Pero pasar la ruta entera por
    `redactar_salida` devuelve un tachon completo, que cumple la politica y no
    informa de nada: quien pregunta donde esta su cerebro necesita una
    respuesta. Asi que se acorta a proposito:
        dentro de casa -> `~/loquesea/modelo.gguf`  (dice donde, no quien)
        fuera de casa  -> `.../carpeta/modelo.gguf` (dice donde, sin prefijo)
    Y despues se COMPRUEBA contra la politica, en vez de suponer que basta.
    """
    if not ruta:
        return None
    casa = os.path.expanduser("~")
    if ruta.startswith(casa):
        visible = "~" + ruta[len(casa):]
    else:
        trozos = ruta.strip("/").split("/")
        visible = "…/" + "/".join(trozos[-2:])
    tachado, hallazgos = G.redactar_salida(visible)
    if hallazgos:
        visible = tachado
    return visible


def _cerebro_paquete(modelo):
    """Que cerebro manda ahora, y cual seria el otro.

    Funcion de modulo y no metodo, por dos razones que apuntan igual: no
    necesita nada del manejador salvo la ruta del base, y el arnes de pruebas
    llama a los metodos sin instanciar la clase -- ahi un `self.otro_metodo()`
    revienta con AttributeError. Lo que no depende de la peticion no vive en
    el manejador.

    `elegir` es quien decide, aqui y en `_estado` y en cada turno. Esta puerta
    no repite su razonamiento: lo consulta. Si lo repitiera, el tablero podria
    decir «usas el afinado» mientras el turno de al lado usa el base.
    """
    raiz = _casa.raiz()
    base = modelo or ""
    eleccion = _afinado.elegir(raiz, base)

    hay_base = bool(base and os.path.isfile(base))
    opciones = [{
        "cual": "base",
        "disponible": hay_base,
        "causa": None if hay_base else (
            "no hay ruta de modelo declarada en esta copia" if not base
            else "la ruta declarada no existe en el disco"),
        "nombre": os.path.basename(base) if base else None,
        "ruta": _ruta_visible(base) if hay_base else None,
        "bytes": os.path.getsize(base) if hay_base else None,
        "version": None,
        "notas": None,
    }]

    # El afinado se declara SIEMPRE, disponible o no. Una lista de una sola
    # opcion se lee como «no hay mas»; si la hay pero no cuadra, la persona
    # necesita saber que existe y por que no puede usarla.
    declarado = (_afinado._registro(raiz) or {}).get("afinado") or {}
    vivo = eleccion.cual == "afinado"
    if not declarado.get("destino"):
        causa = "no hay cerebro afinado declarado"
    elif vivo:
        causa = None
    else:
        # El motivo lo da `elegir`, que es quien lo midio. Escribirlo aqui a
        # mano seria una segunda verdad sobre el mismo hecho.
        causa = eleccion.motivo
    opciones.append({
        "cual": "afinado",
        "disponible": bool(declarado.get("destino")) and causa is None,
        "causa": causa,
        "nombre": (os.path.basename(declarado["destino"])
                   if declarado.get("destino") else None),
        "ruta": _ruta_visible(eleccion.ruta) if vivo else None,
        "bytes": declarado.get("bytes"),
        "version": declarado.get("version"),
        "notas": declarado.get("notas"),
    })

    return {
        "estado": "ok",
        "en_uso": {
            "cual": eleccion.cual,
            "motivo": eleccion.motivo,
            "nombre": os.path.basename(eleccion.ruta) if eleccion.ruta else None,
            "ruta": _ruta_visible(eleccion.ruta),
        },
        "opciones": opciones,
    }


ESTATICOS = {
    # La puerta es el tablero. `app.html` sigue existiendo y se llega desde el
    # -- es el panel de detalle, no la portada.
    "/": ("dashboard.html", "text/html; charset=utf-8"),
    "/dashboard.html": ("dashboard.html", "text/html; charset=utf-8"),
    "/dashboard.css": ("dashboard.css", "text/css; charset=utf-8"),
    "/dashboard.js": ("dashboard.js", "application/javascript; charset=utf-8"),
    "/app.html": ("app.html", "text/html; charset=utf-8"),
    "/app.css": ("app.css", "text/css; charset=utf-8"),
    "/app.js": ("app.js", "application/javascript; charset=utf-8"),
    "/compass.css": ("compass.css", "text/css; charset=utf-8"),
    "/compass.js": ("compass.js", "application/javascript; charset=utf-8"),
    "/manifest.json": ("manifest.json", "application/manifest+json"),
    "/sw.js": ("sw.js", "application/javascript; charset=utf-8"),
}


class PWA(BaseHTTPRequestHandler):

    server_version = "preceptoros-pwa"

    def _json(self, codigo, cuerpo):
        crudo = json.dumps(cuerpo, ensure_ascii=False).encode("utf-8")
        self.send_response(codigo)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(crudo)))
        self.end_headers()
        self.wfile.write(crudo)

    def _leer(self):
        largo = int(self.headers.get("Content-Length") or 0)
        if largo <= 0 or largo > LIMITE:
            return None
        try:
            return json.loads(self.rfile.read(largo).decode("utf-8"))
        except Exception:
            return None

    # --- estáticos ---------------------------------------------------------
    def do_GET(self):
        ruta = self.path.split("?")[0]
        if ruta == "/api/captura":
            return self._captura_listar()
        if ruta == "/api/estado":
            return self._estado()
        if ruta == "/api/camino":
            return self._camino()
        if ruta == "/api/metricas":
            return self._metricas()
        if ruta == "/api/manifiesto":
            return self._manifiesto()
        if ruta == "/api/cerebro":
            return self._cerebro_leer()
        if ruta.startswith("/api/voz"):
            return self._voz()
        if ruta == "/api/perfil":
            return self._perfil_leer()
        if ruta == "/api/proyectos":
            return self._proyectos_leer()
        if ruta.startswith("/assets/"):
            return self._asset(ruta[len("/assets/"):])
        pieza = ESTATICOS.get(ruta)
        if not pieza:
            return self._json(404, {"estado": "NO_DATA",
                                    "motivo": "aquí no vive eso"})
        try:
            with open(os.path.join(INTERFAZ, pieza[0]), "rb") as fh:
                crudo = fh.read()
        except OSError as e:
            return self._json(500, {"estado": "bloqueado",
                                    "motivo": type(e).__name__})
        self.send_response(200)
        self.send_header("Content-Type", pieza[1])
        self.send_header("Content-Length", str(len(crudo)))
        # El HTML no se cachea, y esto costo cuatro sustos el 2026-09-04. El css
        # y el js llevan `?v=N` en el enlace, asi que se refrescan solos al
        # subir el numero -- pero el numero vive DENTRO del html, y si el html
        # esta cacheado nunca se lee. El sintoma es cruel: la pagina ensena una
        # mezcla de version vieja y nueva, y parece que el cambio no se aplico.
        # Se vio con la lamina del titulo, ya borrada del disco y todavia
        # pintada como imagen rota por el alt del marcado viejo.
        if pieza[1].startswith("text/html"):
            self.send_header("Cache-Control", "no-cache, must-revalidate")
        self.end_headers()
        self.wfile.write(crudo)

    def _asset(self, nombre):
        """Las imagenes del producto, por nombre y solo por nombre.

        Se rechaza cualquier cosa que no sea un nombre plano: sin barras y sin
        puntos dobles. Servir un directorio sirve todo lo que hay dentro, y
        dentro de la casa esta la memoria de una persona.
        """
        if not nombre or "/" in nombre or ".." in nombre:
            return self._json(404, {"estado": "NO_DATA",
                                    "motivo": "aquí no vive eso"})
        tipos = {".png": "image/png", ".svg": "image/svg+xml",
                 ".webp": "image/webp", ".gif": "image/gif",
                 ".jpg": "image/jpeg", ".jpeg": "image/jpeg"}
        tipo = tipos.get(os.path.splitext(nombre)[1])
        if tipo is None:
            return self._json(404, {"estado": "NO_DATA",
                                    "motivo": "aquí no vive eso"})
        try:
            with open(os.path.join(AQUI, "assets", nombre), "rb") as fh:
                crudo = fh.read()
        except OSError:
            return self._json(404, {"estado": "NO_DATA",
                                    "motivo": "aquí no vive eso"})
        self.send_response(200)
        self.send_header("Content-Type", tipo)
        self.send_header("Content-Length", str(len(crudo)))
        self.end_headers()
        self.wfile.write(crudo)

    # --- api ---------------------------------------------------------------
    def do_POST(self):
        ruta = self.path.split("?")[0]
        datos = self._leer()
        if datos is None:
            return self._json(400, {"estado": "bloqueado",
                                    "motivo": "cuerpo ilegible o fuera de rango"})
        if ruta == "/api/frontera":
            return self._frontera(datos)
        if ruta == "/api/anidar":
            return self._anidar(datos)
        if ruta == "/api/cerebro":
            return self._cerebro_elegir(datos)
        if ruta == "/api/charla":
            return self._turno(datos)
        if ruta == "/api/captura":
            return self._captura_marcar(datos)
        if ruta == "/api/perfil":
            return self._perfil_guardar(datos)
        if ruta == "/api/proyectos":
            return self._proyectos_guardar(datos)
        return self._json(404, {"estado": "NO_DATA", "motivo": "aquí no vive eso"})

    # Donde vive el Manifiesto. Es doctrina del repositorio, no un asset del
    # producto, asi que NO se copia aqui: dos copias del mismo texto divergen, y
    # la que envejece es siempre la que nadie mira. Se busca donde esta.
    MANIFIESTO = os.path.join(os.path.dirname(AQUI), "Alejandria",
                              "MANIFIESTO_BUILDER.md")

    def _manifiesto(self):
        """El Manifiesto, servido desde el disco de la persona.

        POR QUE NO UN ENLACE A LA WEB, que es lo que se hizo primero y se
        deshizo el 2026-09-04. El canon dice «prohibido rutear a la web desde
        la app», y el motivo es que un enlace saliente dentro de una
        herramienta que promete funcionar sin internet es una ruta a la red
        justo donde se prometio que no la habia. Servirlo de aqui cumple las
        dos cosas: esta accesible, y sigue estandolo en un avion.

        Si el fichero no esta --una instalacion suelta que no trae el arbol de
        doctrina-- se dice, con su causa. No se inventa un texto de relleno ni
        se manda a nadie a buscarlo fuera.
        """
        try:
            with open(self.MANIFIESTO, encoding="utf-8") as fh:
                return self._json(200, {"estado": "ok", "texto": fh.read()})
        except OSError as e:
            return self._json(200, {
                "estado": "NO_DATA",
                "causa": "esta copia no trae el arbol de doctrina, asi que el "
                         "manifiesto no esta en este disco",
                "detalle": type(e).__name__})

    def _metricas(self):
        """Las once de METRICAS_NORMA. La interfaz PINTA; aqui se MIDE.

        El paquete se arma con el cerebro que ya declara `/api/estado`, asi que
        no hay dos verdades sobre que modelo hay: si algun dia cambia el
        cerebro, cambia en un sitio. Y lo que no se pueda medir sale NO_DATA
        con su causa -- `vram_mb` SIEMPRE, porque en esta maquina esa magnitud
        no existe.
        """
        # El cerebro que de verdad contesta, no el que entro por la linea de
        # ordenes. `self.server.modelo` es SIEMPRE el base; con un afinado
        # verificado en uso, esta cabecera decia el nombre del base mientras el
        # selector de justo debajo decia el del afinado. Dos verdades en la
        # misma pantalla, vistas en el tablero el 2026-09-02.
        #
        # No es un detalle cosmetico: la promesa del Banco de Pruebas es «estos
        # tokens por segundo son los de TU cerebro». Con el nombre equivocado,
        # la medida queda atribuida a otro modelo y comparar dos medidas deja
        # de significar nada.
        #
        # `elegir` decide aqui igual que en `_estado` y que en cada turno. Es
        # la misma consulta, no una copia de su razonamiento.
        ruta = self.server.modelo
        try:
            eleccion = _afinado.elegir(_casa.raiz(), ruta or "")
            if eleccion.ruta and os.path.isfile(eleccion.ruta):
                ruta = eleccion.ruta
        except Exception:
            pass                     # con el registro roto manda el base
        cerebro = None
        if ruta and os.path.isfile(ruta):
            cerebro = {"nombre": os.path.basename(ruta),
                       "bytes": os.path.getsize(ruta)}
        paquete = MET.paquete(
            cerebro=cerebro,
            turno=getattr(self.server, "ultimo_turno", None),
            tokens_sesion=getattr(self.server, "tokens_sesion", 0))
        # El Espejo del Builder pide una cosa que el paquete NO puede llevar: la
        # memoria de la maquina. Los once campos son la unidad de comparacion
        # entre maquinas, y meter ahi los gigas del cacharro haria que un
        # portatil y una torre dejaran de ser comparables por un numero que no
        # habla del modelo. Viaja al lado, en su propia llave, igual que el
        # vatiaje del enchufe.
        paquete["espejo"] = MET.memoria_del_sistema()
        return self._json(200, paquete)

    # --- el cerebro · la unica eleccion de modelo que hace la persona -------
    #
    # `afinado.py` sabia elegir desde hacia tiempo y ninguna ruta lo exponia:
    # la logica estaba escrita y desconectada. Esto la conecta.
    #
    # EL LIMITE, escrito antes que el codigo porque es lo que importa: por esta
    # puerta NO viaja NUNCA una ruta de fichero. La interfaz manda una de dos
    # palabras -- `base` o `afinado` -- y el servidor resuelve las rutas con
    # `casa.raiz()`. `promover()`, que si acepta una ruta y le mide la huella,
    # se queda en la forja y no se expone: el dia que una interfaz pueda mandar
    # rutas, puede mandar cualquier ruta.

    def _cerebro_leer(self):
        try:
            return self._json(200, _cerebro_paquete(self.server.modelo))
        except Exception as e:                      # nunca tumba el tablero
            return self._json(500, {"estado": "bloqueado",
                                    "motivo": type(e).__name__})

    def _cerebro_elegir(self, datos):
        """Cambiar de cerebro es escribir una preferencia. No mueve un byte.

        El hot-swap es trivial, y no por suerte: `motor_llama` lanza el proceso
        hijo en CADA turno, asi que no hay demonio que reiniciar. A que fichero
        apunta el turno siguiente ES el cambio.
        """
        cual = datos.get("cual")
        if cual not in CEREBROS:
            # Vocabulario cerrado. Cualquier otra cosa -- una ruta, un numero,
            # un diccionario -- se rechaza sin mirarla siquiera.
            return self._json(400, {"estado": "bloqueado",
                                    "motivo": "solo 'base' o 'afinado'"})
        motivo = datos.get("motivo")
        if not isinstance(motivo, (str, type(None))):
            return self._json(400, {"estado": "bloqueado", "motivo": "TypeError"})
        motivo = (motivo or "").strip() or "sin motivo declarado"

        try:
            raiz = _casa.raiz()
            if cual == "base":
                _afinado.rollback(raiz, motivo)
            elif not _afinado.restaurar(raiz, motivo):
                # `restaurar` devuelve False cuando no hay nada que restaurar.
                # Se dice, en vez de responder 200 sobre un cambio que no paso.
                return self._json(409, {"estado": "bloqueado",
                                        "motivo": "no hay cerebro afinado declarado"})
            paquete = _cerebro_paquete(self.server.modelo)
        except OSError as e:
            return self._json(500, {"estado": "bloqueado",
                                    "motivo": type(e).__name__})

        # Se responde con lo que `elegir` dice AHORA, no con lo que se pidio.
        # Pedir el afinado y que su huella no cuadre termina en el base, y la
        # persona tiene que verlo -- no un «hecho» que no describe la realidad.
        return self._json(200, paquete)

    def _estado(self):
        with M.abrir(self.server.ruta_db) as c:
            perfil = M.leer_perfil(c)
            cuenta = C.recuento(c)
        motor = _charla.motor_disponible()
        ruta = self.server.modelo
        hay = bool(ruta and os.path.isfile(ruta))
        # QUE cerebro y DONDE, no solo que hay uno. «Instalado» no distingue un
        # 4B de un 27B, y quien mide tok/s necesita saber cual midio. Si falta,
        # se dice que falta y por que: la ruta esperada tambien es un dato.
        # La ruta NO sale cruda. `HOME_PATH` es una politica de redaccion ACTIVA
        # de este producto: escupir /home/<quien> en el tablero seria saltarse
        # su propio guardian.
        #
        # Y no basta con pasarla por `redactar_salida`: eso devuelve la ruta
        # entera como [REDACTED:HOME_PATH], que cumple la politica y no informa
        # de nada. Quien pregunta donde esta su cerebro necesita una respuesta,
        # no un tachon. Asi que se acorta a proposito:
        #   dentro de casa  -> `~/loquesea/modelo.gguf`  (dice donde, no quien)
        #   fuera de casa   -> `…/carpeta/modelo.gguf`   (dice donde, sin prefijo)
        # Ninguna de las dos formas casa con el patron de la politica, y eso se
        # COMPRUEBA aqui abajo en vez de suponerse.
        # Que cerebro manda HOY: el base o el afinado. `elegir` verifica la
        # huella del afinado contra el disco, asi que un LoRA declarado y
        # ausente —o cambiado— cae al base y lo dice. La marca del producto es
        # el modelo que de verdad contesta, no el que figura en un registro.
        try:
            eleccion = _afinado.elegir(_casa.raiz(), ruta or "")
            afinado_vivo = eleccion.cual == "afinado"
            afinado_motivo = eleccion.motivo
            if afinado_vivo and os.path.isfile(eleccion.ruta):
                ruta = eleccion.ruta
                hay = True
        except Exception as e:                       # nunca tumba el tablero
            afinado_vivo, afinado_motivo = False, f"no se pudo consultar: {e}"
        cerebro = {
            "nombre": os.path.basename(ruta) if hay else None,
            "afinado": afinado_vivo,
            "motivo": afinado_motivo,
            "ruta": _ruta_visible(ruta),
            "bytes": os.path.getsize(ruta) if hay else None,
            "causa": None if hay else (
                "no hay ruta de modelo declarada en esta copia" if not ruta
                else "la ruta declarada no existe en el disco"),
        }
        return self._json(200, {
            "estado": "ok",
            "idioma": perfil.get("language", "es"),
            "motor": bool(motor and hay),
            "cerebro": cerebro,
            "captura_activa": C.activa(perfil),
            "personalizada": str(perfil.get("personalizada", "si"))
                             .strip().lower() not in ("no", "0", "false", "off"),
            "turnos": cuenta,
            # La huella del armazon que sirve esta copia. Existe para poder
            # comparar dos instalaciones: el telefono guarda la cara en el
            # service worker y puede seguir ensenando la de anteayer sin que
            # nadie lo note -- todo funciona, y los dos creen mirar lo mismo.
            "version": _version.version(),
        })

    # 100.64.0.0/10 es el rango que usa Tailscale. Se comprueba por prefijo y no
    # por nombre: un nombre lo resuelve quien controle el DNS, un rango no.
    @staticmethod
    def _es_local(ip):
        if ip in ("127.0.0.1", "::1", "localhost"):
            return True
        if ip.startswith("127."):
            return True
        try:
            partes = [int(x) for x in ip.split(".")]
        except ValueError:
            return False
        return len(partes) == 4 and partes[0] == 100 and 64 <= partes[1] <= 127

    def _consulta(self):
        from urllib.parse import parse_qs, urlparse
        return parse_qs(urlparse(self.path).query)

    def _brujula(self, modo, debug):
        """La Brujula. **Sensor de memory.db, jamas actuador.**

        Vive detras de `?modo=`, y eso no es capricho: sin el parametro,
        `/api/camino` devuelve EXACTAMENTE lo que devolvia antes. `dashboard.js`
        lo consume desde el 23 de agosto y romperle el contrato para estrenar un
        widget seria cambiar algo que funciona por algo que todavia no.
        """
        try:
            import compass as _compass
        except Exception as e:
            return self._json(503, {"error": "compass_unavailable",
                                    "motivo": f"no se pudo importar: {e}"})
        try:
            loops = os.path.join(str(_casa.raiz()), "loops.db")
            b = _compass.LearningCompass(self.server.ruta_db, loops, modo=modo)
            return self._json(200, b.resumen(modo=modo, debug=debug))
        except Exception as e:
            return self._json(503, {"error": "compass_unavailable",
                                    "motivo": str(e)[:200]})

    def _camino(self):
        """Los ocho peldanos, medidos. No estaba expuesto en ninguna ruta.

        `progreso_camino` existia y se usaba DENTRO del turno; nada lo sacaba
        a la cara. El Camino vivia solo en el HTML que genera `cara.py`, que
        esta puerta no sirve -- asi que desde el tablero no habia forma de
        verlo. No estaba escondido: no estaba conectado.

        Los nombres salen de `cara.CAMINO`, que es de donde los saca el
        producto. Si vivieran aqui tambien, el dia que cambie uno habria que
        acertar en dos sitios.
        """
        q = self._consulta()
        modo = (q.get("modo") or [None])[0]
        debug = (q.get("debug") or ["0"])[0] == "1"
        if debug and not self._es_local(self.client_address[0]):
            return self._json(403, {"error": "debug_no_permitido",
                                    "motivo": "?debug=1 solo desde loopback o tailnet"})
        if modo in ("camino", "detalle"):
            return self._brujula(modo, debug)
        if modo is not None:
            return self._json(400, {"error": "modo_desconocido",
                                    "motivo": "modo debe ser camino o detalle"})

        with M.abrir(self.server.ruta_db) as c:
            perfil = M.leer_perfil(c)
            idioma = perfil.get("language", "es")
            camino = _cara.progreso_camino(c, self.server.ruta_db)
        nombres = dict(_cara.CAMINO.get(idioma, _cara.CAMINO["es"]))
        nucleo = set(camino.get("nucleo", ()))
        peldanos = [
            {"id": clave,
             "nombre": nombres.get(clave, clave),
             "estado": camino["estado"].get(clave, "sin_empezar"),
             "rama": "nucleo" if clave in nucleo else "opcional"}
            for clave, _ in _cara.CAMINO.get(idioma, _cara.CAMINO["es"])
        ]
        return self._json(200, {"estado": "ok", "idioma": idioma,
                                "peldanos": peldanos,
                                "cifras": camino.get("cifras", {})})

    def _perfil_leer(self):
        with M.abrir(self.server.ruta_db) as c:
            perfil = M.leer_perfil(c)
        return self._json(200, {
            "estado": "ok",
            # La Huella Soberana (SHA256). NO es Ed25519, y se nombra por lo
            # que es: la stdlib no trae Ed25519, y este producto no admite otra
            # dependencia. Tampoco es una clave -- no firma nada y no da acceso
            # a nada; es un nombre pseudonimo y estable para esta instalacion.
            # Si falta o esta rota, sale NO_DATA con causa: jamas un valor
            # inventado en su hueco.
            "identidad": _huella.leer(_casa.raiz()),
            "avatares": {k: list(v) for k, v in FAMILIAS_AVATAR.items()},
            "campos": {k: perfil.get(k, "NO_DATA") for k in CAMPOS_PERFIL},
        })

    def _perfil_guardar(self, datos):
        """Solo los campos que esta puerta declara. Nada de escribir el perfil
        entero con lo que llegue: el perfil tiene claves que el producto pone y
        la interfaz no debe poder tocar."""
        escritos = []
        with M.abrir(self.server.ruta_db) as c:
            for clave in CAMPOS_PERFIL:
                if clave not in datos:
                    continue
                valor = datos[clave]
                if not isinstance(valor, str) or len(valor) > 4000:
                    return self._json(400, {"estado": "bloqueado",
                                            "motivo": f"{clave} fuera de rango"})
                # El avatar no es texto: es una de ocho. Se comprueba contra la
                # lista, no contra una forma -- una comprobacion por forma
                # («que acabe en .webp», «que no lleve barras») se salta antes
                # o despues, y una lista de ocho no se salta.
                if clave == "avatar" and valor not in AVATARES:
                    return self._json(400, {"estado": "bloqueado",
                                            "motivo": "esa cara no existe"})
                M.escribir_perfil(c, clave, valor.strip() or "NO_DATA")
                escritos.append(clave)
            perfil = M.leer_perfil(c)
        return self._json(200, {"estado": "ok", "escritos": escritos,
                                "campos": {k: perfil.get(k, "NO_DATA")
                                           for k in CAMPOS_PERFIL}})

    def _proyectos_leer(self):
        with M.abrir(self.server.ruta_db) as c:
            return self._json(200, {"estado": "ok", "proyectos": PR.listar(c)})

    # Los campos que un proyecto acepta por la puerta. Se declaran aqui y no se
    # deducen de lo que llegue: sin esta lista, un `editar` con una clave de mas
    # se cuela hasta el `update` y decide el nombre de una columna desde fuera.
    CAMPOS_PROYECTO = ("titulo", "descripcion", "estado", "nota", "ruta")

    def _proyectos_guardar(self, datos):
        with M.abrir(self.server.ruta_db) as c:
            if datos.get("quitar") is not None:
                pid = datos.get("quitar")
                ok = isinstance(pid, int) and PR.quitar(c, pid)
            elif datos.get("editar") is not None:
                pid = datos.get("editar")
                campos = {k: datos[k] for k in self.CAMPOS_PROYECTO if k in datos}
                ok = isinstance(pid, int) and PR.editar(c, pid, **campos)
            else:
                ok = PR.anadir(c, datos.get("titulo", ""),
                               datos.get("ruta", ""), datos.get("nota", ""),
                               datos.get("descripcion", ""),
                               datos.get("estado", "activo")) is not None
            lista = PR.listar(c)
        return self._json(200 if ok else 400,
                          {"estado": "ok" if ok else "bloqueado",
                           "proyectos": lista})

    def _voz(self):
        """¿Puede hablar esta copia? Se contesta con el disco, no con un deseo.

        La voz son dos piezas: el binario de piper y el modelo firmado. En el
        Doogee esta el modelo (61 MB) y NO esta el binario, asi que la
        respuesta honesta es "tengo media pieza" -- y se dice cual falta, no un
        "no disponible" que manda a mirar donde no es.
        """
        # Se pregunta al producto, no se reimplementa la pregunta.
        # `piper_disponible()` ya mira el binario, el modelo Y si la maquina
        # declara el hardware apagado -- esa ultima no la habria puesto yo.
        #
        # Y `piper_binario()` devuelve la CADENA "NO_DATA" cuando no lo
        # encuentra, no None. La primera version de esto hacia `bool(binario)`
        # y una cadena no vacia es verdadera: el endpoint decia que el Doogee
        # podia hablar cuando no tiene piper instalado. Un sensor que miente
        # sobre una ausencia es peor que no tenerlo.
        binario = _voz.piper_binario() != _voz.NO_DATA
        modelo = os.path.isfile(_voz.MODELO_DEFECTO)
        return self._json(200, {
            "estado": "ok",
            "puede": _voz.piper_disponible(),
            "binario": binario,
            "modelo": modelo,
            "falta": ("nada" if (binario and modelo)
                      else "el binario de piper" if modelo
                      else "el modelo de voz" if binario
                      else "el binario y el modelo"),
        })

    def _frontera(self, datos):
        """El filtro, y su payload entero. Fail-closed de verdad."""
        texto = datos.get("texto") or ""
        if not isinstance(texto, str):
            return self._json(400, {"estado": "bloqueado", "motivo": "TypeError"})
        try:
            payload = G.preparar_envio(texto)
        except G.EnvioBloqueado as e:
            # Estado 4. No hay campo que permita mandar igualmente: si esta
            # rama devolviera el texto, la interfaz tendria la tentacion, y un
            # filtro caido no es lo mismo que un texto limpio.
            return self._json(409, {"estado": "bloqueado", "motivo": str(e)})
        return self._json(200, payload)

    def _anidar(self, datos):
        """La Aduana con salida: el texto de fuera entra en la memoria.

        Este es el paso que le faltaba a la doctrina Caza-Nido. `/api/frontera`
        comprueba y ensena; no guardaba nada, asi que el usuario veia lo que se
        iba a tachar y luego no tenia por donde meterlo. El circulo se cierra
        aqui.

        LA REGLA QUE SOSTIENE TODO ESTO
        -------------------------------
        El servidor NO SE FIA de lo que le mande la interfaz. Vuelve a filtrar
        el, siempre, y escribe en disco el resultado de SU filtro -- nunca un
        campo del cuerpo que diga venir ya limpio. Una aduana que acepta el
        sello que trae el paquete no es una aduana; es un buzon.

        Por eso el cuerpo solo se mira por `texto` y `porque`. Si manana la
        interfaz mandara un `texto_limpio`, este metodo lo ignora sin decir
        nada: no hay rama por la que un texto sin filtrar llegue al `insert`.

        FAIL-CLOSED, igual que `/api/frontera`. Si el filtro no termina no se
        escribe una fila a medias: no hay recuerdo, se devuelve 409, y NO viaja
        el texto de vuelta -- si viajara, la interfaz tendria la tentacion de
        guardarlo por su cuenta.

        Y `origin='importado'`, que es uno de los tres que admite el CHECK del
        esquema y justo el que significa esto. Sin esa marca, un parrafo cazado
        en una IA ajena se leeria dentro de seis meses como algo que dijo la
        persona.
        """
        texto = datos.get("texto")
        porque = datos.get("porque")
        if not isinstance(texto, str) or not isinstance(porque, (str, type(None))):
            return self._json(400, {"estado": "bloqueado", "motivo": "TypeError"})
        if not texto.strip():
            # Un recuerdo vacio no es un recuerdo. Se para aqui y no en el
            # ValueError de `memory`, para que la interfaz reciba un motivo
            # y no una traza.
            return self._json(400, {"estado": "bloqueado",
                                    "motivo": "no hay nada que anidar"})

        # Los DOS campos por el filtro. El segundo es el que se olvida: un
        # «por que» lleva tanto contexto como el «que», y a veces mas.
        try:
            limpio = G.preparar_envio(texto)
            limpio_porque = G.preparar_envio(porque) if porque and porque.strip() else None
        except G.EnvioBloqueado as e:
            return self._json(409, {"estado": "bloqueado", "motivo": str(e)})

        hallazgos = list(limpio["hallazgos"])
        if limpio_porque:
            hallazgos += list(limpio_porque["hallazgos"])

        with M.abrir(self.server.ruta_db) as c:
            fila = M.escribir_engrama(
                c, what=limpio["texto"],
                why=limpio_porque["texto"] if limpio_porque else None,
                origin="importado")

        # Se devuelve lo GUARDADO, no lo recibido. Si la persona no puede ver
        # que se tacho de su texto, esta firmando a ciegas lo que entra en su
        # propia memoria.
        return self._json(200, {"estado": "ok", "id": fila["id"],
                                "texto": fila["what"], "porque": fila["why"],
                                "hallazgos": hallazgos,
                                "policy_hash": limpio["policy_hash"]})

    def _turno(self, datos):
        dicho = (datos.get("texto") or "").strip()
        if not dicho:
            return self._json(400, {"estado": "bloqueado", "motivo": "vacío"})
        ruta = self.server.ruta_db
        with M.abrir(ruta) as c:
            perfil = M.leer_perfil(c)
            idioma = perfil.get("language", "es")
            camino = _cara.progreso_camino(c, ruta)
            motor = _charla.motor_llama(self.server.modelo)
            if motor is None:
                return self._json(503, {"estado": "bloqueado",
                                        "motivo": "sin motor"})
            try:
                # `personalizada` decide si el turno lleva el harness --prompt
                # de sistema, instrucciones, idioma y punto del Camino-- o si
                # la pregunta viaja sola. Por defecto si: la app existe para
                # eso. Apagarlo es una prueba, no un modo de trabajo.
                turno = _charla.turno(
                    c, dicho, camino, motor=motor, idioma=idioma,
                    personalizada=str(perfil.get("personalizada", "si"))
                    .strip().lower() not in ("no", "0", "false", "off"))
            except _charla.SeAgotoElTiempo as e:
                return self._json(504, {"estado": "tarde", "motivo": str(e)})
            except Exception as e:
                return self._json(500, {"estado": "bloqueado",
                                        "motivo": type(e).__name__})
            tid = None
            if C.activa(perfil):
                tid = C.registrar(c, dicho, turno["texto"],
                                  modelo=self.server.modelo or "NO_DATA",
                                  idioma=idioma)
        return self._json(200, {"estado": "ok", "texto": turno["texto"],
                                "turno_id": tid})

    def _captura_listar(self):
        with M.abrir(self.server.ruta_db) as c:
            C.asegurar(c)
            filas = list(c.execute(
                "select id, cuando, prompt, respuesta, consent, correccion "
                "from turnos order by id desc limit 50"))
            cuenta = C.recuento(c)
        return self._json(200, {"estado": "ok", "recuento": cuenta, "turnos": [
            {"id": f[0], "cuando": f[1], "prompt": f[2], "respuesta": f[3],
             "consent": bool(f[4]), "correccion": f[5]} for f in filas]})

    def _captura_marcar(self, datos):
        """Consentir o revocar. UNO por petición: el carbono marca de uno en uno."""
        tid = datos.get("id")
        if not isinstance(tid, int):
            return self._json(400, {"estado": "bloqueado", "motivo": "id"})
        with M.abrir(self.server.ruta_db) as c:
            if "correccion" in datos:
                ok = C.corregir(c, tid, datos.get("correccion") or "",
                                motivo=datos.get("motivo") or "NO_DATA")
            else:
                ok = C.consentir(c, tid, bool(datos.get("consent")),
                                 motivo=datos.get("motivo") or "NO_DATA")
            cuenta = C.recuento(c)
        return self._json(200 if ok else 404,
                          {"estado": "ok" if ok else "NO_DATA",
                           "recuento": cuenta})

    def log_message(self, formato, *args):
        sys.stderr.write("[pwa] %s\n" % (formato % args))


def main(argv=None):
    import argparse
    ap = argparse.ArgumentParser(description="Preceptor · la cara premium")
    # La raiz la decide `casa`, y solo `casa`. Escribirla a mano aqui es
    # exactamente lo que ese modulo existe para impedir: el dia que el
    # producto se renombre, este guion seguiria mirando a la casa vieja
    # mientras el resto mira a la nueva.
    ap.add_argument("--db", default=str(_casa.raiz() / "memory.db"))
    ap.add_argument("--modelo", default=os.path.join(
        str(_casa.raiz()), "modelos/qwen3-4b-instruct-2507-Q4_K_M.gguf"))
    a = ap.parse_args(argv)

    servidor = ThreadingHTTPServer((BIND, PUERTO), PWA)
    servidor.ruta_db = a.db
    servidor.modelo = a.modelo
    print(f"[pwa] escuchando en {BIND}:{PUERTO} · memoria: {a.db}")
    if BIND not in ("127.0.0.1", "::1", "localhost"):
        print("[pwa] AVISO: no estás en loopback. Esto escucha fuera de esta "
              "máquina, y eso es una decisión, no un descuido.")
    try:
        servidor.serve_forever()
    except KeyboardInterrupt:
        print("\n[pwa] cerrado")
    return 0


if __name__ == "__main__":
    sys.exit(main())
