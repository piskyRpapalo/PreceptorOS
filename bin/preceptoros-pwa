# Los origenes que la puerta admite, y son los tres del CHECK de `engrams`.
# `importado` es el defecto porque anidar nacio para la doctrina Caza-Nido;
# `persona` es el gesto de «guarda esto» sobre lo que uno mismo escribio. La
# diferencia no es cosmetica: es lo unico que dentro de seis meses separa un
# parrafo propio de uno cazado en una IA ajena, y no se reconstruye despues.
#
# Vocabulario CERRADO, y vive fuera de la clase por lo mismo que
# `proyectos.ESTADOS`: es del producto, no del manejador.
ORIGENES = ("persona", "intencion", "importado")


def _ruta_visible(ruta):
    """Una ruta que se puede ensenar. Vivia dentro de `_estado` y ahora la
    comparten dos puertas: si la regla cambiara en un sitio y no en el otro,
    una de las dos escupiria el nombre de la persona en su propio tablero.

    `HOME_PATH` es una politica de redaccion activa de este producto, asi que
    su tablero no puede saltarsela. Pero pasar la ruta entera por
    `redactar_salida` devuelve un tachon completo, que cumple la politica y no
    informa de nada: quien pregunta donde esta su cerebro necesita una
    respuesta. Asi que se acorta a proposito:
        dentro de casa -> `~/loquesea/modelo.gguf`  (dice donde, no quien)
        fuera de casa  -> `.../carpeta/modelo.gguf` (dice donde, sin prefijo)
    Y despues se COMPRUEBA contra la politica, en vez de suponer que basta.
    """
    if not ruta:
        return None
    casa = os.path.expanduser("~")
    if ruta.startswith(casa):
        visible = "~" + ruta[len(casa):]
    else:
        trozos = ruta.strip("/").split("/")
        visible = "…/" + "/".join(trozos[-2:])
    tachado, hallazgos = G.redactar_salida(visible)
    if hallazgos:
        visible = tachado
    return visible


def _cerebro_paquete(modelo):
    """Que cerebro manda ahora, y cual seria el otro.

    Funcion de modulo y no metodo, por dos razones que apuntan igual: no
    necesita nada del manejador salvo la ruta del base, y el arnes de pruebas
    llama a los metodos sin instanciar la clase -- ahi un `self.otro_metodo()`
    revienta con AttributeError. Lo que no depende de la peticion no vive en
    el manejador.

    `elegir` es quien decide, aqui y en `_estado` y en cada turno. Esta puerta
    no repite su razonamiento: lo consulta. Si lo repitiera, el tablero podria
    decir «usas el afinado» mientras el turno de al lado usa el base.
    """
    raiz = _casa.raiz()
    base = modelo or ""
    eleccion = _afinado.elegir(raiz, base)

    hay_base = bool(base and os.path.isfile(base))
    opciones = [{
        "cual": "base",
        "disponible": hay_base,
        "causa": None if hay_base else (
            "no hay ruta de modelo declarada en esta copia" if not base
            else "la ruta declarada no existe en el disco"),
        "nombre": os.path.basename(base) if base else None,
        "ruta": _ruta_visible(base) if hay_base else None,
        "bytes": os.path.getsize(base) if hay_base else None,
        "version": None,
        "notas": None,
    }]

    # El afinado se declara SIEMPRE, disponible o no. Una lista de una sola
    # opcion se lee como «no hay mas»; si la hay pero no cuadra, la persona
    # necesita saber que existe y por que no puede usarla.
    declarado = (_afinado._registro(raiz) or {}).get("afinado") or {}
    vivo = eleccion.cual == "afinado"
    if not declarado.get("destino"):
        causa = "no hay cerebro afinado declarado"
    elif vivo:
        causa = None
    else:
        # El motivo lo da `elegir`, que es quien lo midio. Escribirlo aqui a
        # mano seria una segunda verdad sobre el mismo hecho.
        causa = eleccion.motivo
    opciones.append({
        "cual": "afinado",
        "disponible": bool(declarado.get("destino")) and causa is None,
        "causa": causa,
        "nombre": (os.path.basename(declarado["destino"])
                   if declarado.get("destino") else None),
        "ruta": _ruta_visible(eleccion.ruta) if vivo else None,
        "bytes": declarado.get("bytes"),
        "version": declarado.get("version"),
        "notas": declarado.get("notas"),
    })

    return {
        "estado": "ok",
        "en_uso": {
            "cual": eleccion.cual,
            "motivo": eleccion.motivo,
            "nombre": os.path.basename(eleccion.ruta) if eleccion.ruta else None,
            "ruta": _ruta_visible(eleccion.ruta),
        },
        "opciones": opciones,
    }


