#!/usr/bin/env bash
# El numero de pruebas de Preceptor sale de AQUI, y de un solo sitio.
#
# Por que existe: `python3 -m unittest discover` dice OK habiendo corrido la
# mitad de la suite, porque cinco ficheros traen corredor propio y discover no
# los ve. Un OK que solo cubre el 55% no es un OK: es media medida presentada
# como entera. Este script corre TODOS los corredores y da el desglose, para
# que el numero del README se pueda comprobar en vez de recordarse.
#
# Uso:  bin/pruebas            los corredores + los sabotajes
#       bin/pruebas --rapido   sin sabotajes (copian el arbol; tardan)
#
# Salida 0 solo si todo esta verde.

set -uo pipefail
cd "$(dirname "$0")/.." || exit 2

# --- el mismo sistema de ficheros en todas las tandas (M-D80b) --------------
# `/tmp` en esta maquina es tmpfs -- RAM -- y `/var/tmp` es el NVMe. Hasta aqui
# las tandas usaban uno u otro segun el TMPDIR que trajera la sesion, sin que
# nadie lo hubiera elegido: dos tandas con el mismo numero podian no haber
# corrido en el mismo sitio, y eso no se veia por ninguna parte.
#
# Importa para el rojo del 2026-08-16. Un tmpfs lleno devuelve ENOSPC sin
# dejar rastro en el journal y sin disparar oom-kill, asi que ese flanco NO lo
# cierra la ausencia de registro -- lo unico que lo cierra es correr siempre en
# un sitio conocido y con espacio medido. Si el rojo vuelve, vuelve ahi.
#
# `:-` y no una asignacion seca: lo que la persona declara manda, como en el
# resto del arbol. Por eso el sitio se IMPRIME en la cabecera -- si una sesion
# trae su propio TMPDIR, la tanda no se lo discute, pero tampoco lo esconde.
export TMPDIR="${TMPDIR:-/var/tmp}"
if [ ! -d "$TMPDIR" ] || [ ! -w "$TMPDIR" ]; then
  echo "PARADA · TMPDIR=$TMPDIR no existe o no se puede escribir." >&2
  echo "         Sin temporal no hay tanda, y una tanda que cae por esto se" >&2
  echo "         parece demasiado a una que falla por otra cosa." >&2
  exit 2
fi

RAPIDO=0
[ "${1:-}" = "--rapido" ] && RAPIDO=1

rojo=$'\033[31m'; verde=$'\033[32m'; ambar=$'\033[33m'; gris=$'\033[90m'; fin=$'\033[0m'
[ -t 1 ] || { rojo=""; verde=""; ambar=""; gris=""; fin=""; }

TOTAL=0
FALLOS=0
LINEAS=()

# Ni microfono, ni sintesis, ni altavoz, en toda la tanda y en los procesos
# hijo que arranquen las suites. Ver `silencio.py`. Sin esto, en una maquina
# con whisper.cpp instalado la tanda graba la habitacion.
export PRECEPTOROS_SIN_HARDWARE=1
# Y el ritmo del relato a cero: las pausas son para la persona, no para el CI.
export PRECEPTOROS_RITMO=0

# --- el aviso que va PRIMERO ------------------------------------------------
# Un verde sobre trabajo sin commitear es un verde que un `git checkout` borra.
# No se falla por ello -- se trabaja sin commitear todo el rato -- pero no se
# deja pasar en silencio.
SUCIO="$(git --no-optional-locks status --porcelain 2>/dev/null)"
if [ -n "$SUCIO" ]; then
  echo "${ambar}AVISO · hay trabajo sin commitear. Este numero no esta guardado:${fin}"
  echo "$SUCIO" | sed 's/^/    /'
  echo
fi

# --- corredor 1 · las suites unittest, una a una ----------------------------
# Una a una y no con `discover`, porque discover da un solo total y lo que
# hace falta es el desglose: si manana una suite desaparece del arbol, un
# total agregado baja sin que nadie sepa cual falta.
suite_unittest() {
  local nombre="$1" informe n codigo extra=""
  # El informe de unittest va por stderr y lo que imprimen los casos por
  # stdout. Mezclarlos con `2>&1` parece comodo y no lo es: stdout sale con
  # bufer y stderr sin el, asi que el "OK" final aparece PEGADO a media linea
  # de otro sitio y un `grep '^OK'` no lo encuentra. Se separan los dos
  # canales, y el veredicto lo da el codigo de salida, que no se puede partir.
  informe="$(timeout 600 python3 -m unittest "$nombre" 2>&1 >/dev/null)"
  codigo=$?
  n="$(printf '%s' "$informe" | sed -n 's/^Ran \([0-9]*\) test.*/\1/p' | tail -1)"
  n="${n:-0}"
  TOTAL=$((TOTAL + n))
  if [ "$codigo" = "0" ]; then
    printf '%s' "$informe" | grep -qE '^OK \(' && \
      extra=" $gris($(printf '%s' "$informe" | sed -n 's/^OK (\(.*\))/\1/p'))$fin"
    LINEAS+=("  ${verde}ok${fin}    ${nombre}.py $(printf '%*s' $((26 - ${#nombre})) '')${n}${extra}")
  else
    FALLOS=$((FALLOS + 1))
    LINEAS+=("  ${rojo}FALLO${fin} ${nombre}.py $(printf '%*s' $((26 - ${#nombre})) '')${n}")
    LINEAS+=("$(printf '%s' "$informe" | grep -E '^(FAIL|ERROR):' | sed 's/^/          /')")
  fi
}

# --- corredores 2-6 · las suites con main() propio ---------------------------
suite_propia() {
  local nombre="$1" salida linea ok n codigo
  salida="$(timeout 600 python3 "test_${nombre}.py" 2>&1)"
  codigo=$?
  linea="$(printf '%s' "$salida" | grep -E '^RESULTADO:' | tail -1)"
  ok="$(printf '%s' "$linea" | sed -n 's#^RESULTADO: \([0-9]*\)/\([0-9]*\).*#\1#p')"
  n="$(printf '%s' "$linea" | sed -n 's#^RESULTADO: \([0-9]*\)/\([0-9]*\).*#\2#p')"
  ok="${ok:-0}"; n="${n:-0}"
  TOTAL=$((TOTAL + n))
  # Dos condiciones y hacen falta las dos: el recuento que imprime la suite Y
  # su codigo de salida. Si divergen, es que la suite miente en una de las
  # dos, y eso ya es un fallo.
  if [ "$codigo" = "0" ] && [ "$ok" = "$n" ] && [ "$n" != "0" ]; then
    LINEAS+=("  ${verde}ok${fin}    test_${nombre}.py $(printf '%*s' $((21 - ${#nombre})) '')${n}")
  else
    FALLOS=$((FALLOS + 1))
    LINEAS+=("  ${rojo}FALLO${fin} test_${nombre}.py $(printf '%*s' $((21 - ${#nombre})) '')${ok}/${n}")
    LINEAS+=("$(printf '%s' "$salida" | grep -E '^ +(FALLO|ERROR) ·' | sed 's/^/        /')")
  fi
}

# --- el interprete, con nombre y numero -------------------------------------
# Una cifra sin su maquina es un rumor con decimales. "217/217 verde" no dice
# nada si no consta CON QUE se corrio: el mismo arbol da numeros distintos en
# interpretes distintos, y esa es justamente la clase de diferencia que hay que
# poder ver. Va en la cabecera y no al final, para que salga aunque la tanda se
# corte a la mitad -- si se corta, el interprete es el primer dato que hace
# falta.
echo "── PRECEPTOROS · TODAS LAS PRUEBAS ────────────────────────────────"
echo "  ${gris}$(python3 -V 2>&1) · $(command -v python3)${fin}"
# El temporal, por el mismo motivo que el interprete: una cifra sin su maquina
# es un rumor con decimales, y "donde escribio" es parte de la maquina. Sale
# el tipo de sistema de ficheros porque es el dato que separa RAM de disco.
echo "  ${gris}TMPDIR=${TMPDIR} · $(df -hT "$TMPDIR" 2>/dev/null | \
      awk 'NR==2 {print $2" | "$5" libres"}')${fin}"
# El rango probado sale de `interprete.py`, el mismo sitio del que lo saca el
# producto: si viviera aqui tambien, el dia que se pruebe una version nueva
# habria que acertar en dos ficheros. Una tanda fuera de rango se corre igual
# -- se anota, no se impide.
AVISO_V="$(python3 -c 'import interprete; print((interprete.aviso() or "").split(chr(10))[0])' 2>/dev/null)"
[ -n "$AVISO_V" ] && echo "  ${ambar}${AVISO_V}${fin}"
echo

# El reparto. Si anades una suite, va aqui: es la unica lista.
UNITTEST=(test_herencia_web test_app_una_pestana test_transicion_app test_estado_app test_estado_compacto test_ficha_cartucho test_orquestador_rag test_orquestador_respuesta test_lab_frase test_afinado test_captura test_descarga test_pwa test_llms test_restaurar test_estado test_fuga test_guardrails test_privacidad_arbol test_ideas18oct_contracts test_lexical_projection
          test_interprete test_leitmotivs test_silencio test_voz_cyber test_voz_creacion test_creacion_import test_creacion_publicacion test_creacion_voz_route test_creacion_recorrido test_path test_casa test_entorno
          test_compass test_exportar
          # Las trece que el corredor dejaba fuera (deuda S4). Escondieron
          # dos roturas reales: el renombrado del output-guard y el de la
          # identidad del arquetipo. Una suite que existe y no corre es una
          # suite que miente sobre lo que cubre.
          test_andamio test_borradores test_conversacion test_costura
          test_frontera test_hilos test_identidad test_narrador test_mcp_stdio_receipt
          test_output_guard test_api_guia_capa1 test_puente test_puerta test_recuperacion
          test_traza test_version
          # test_face: la cara nueva (chat + joystick), la misma que la web.
          test_face
          # El guardian. Entra en el corredor en su MISMO commit: una suite que
          # existe y no corre miente sobre lo que cubre, y esta cubre el suelo.
          #
          # test_superficie: el candado de la firma de wasmtime (2026-08-30).
          # Recorre el grafo de imports desde las tres puertas del producto y
          # exige que el camino por defecto sea stdlib puro. Entra aqui en su
          # mismo commit por la misma razon: un candado que no corre no cierra.
          test_superficie test_atlas_riesgo test_pwa_bind test_lora_signed_download
          # Every suite is counted separately; test_superficie catches omissions.
          test_huella test_metricas test_herramientas test_empieza_aqui test_soberano
          test_importar test_medidas test_cifras test_compliance
          # test_linea y test_normas: el registro encadenado y la tabla de
          # anclas legislativas. Entran en su mismo commit. La primera lleva
          # dentro la prueba del SABOTEADOR --se manipula una fila por debajo y
          # se exige que se cace-- y, lo que es mas raro, la que demuestra lo
          # que NO garantiza: rehacer la cadena entera cuadra. Una suite que
          # solo ensena lo que la pieza detecta deja creer que detecta todo.
          test_linea
          test_normas
          test_soberania
          # test_apretar: la compresion de contexto que SOLO puede borrar
          # unidades enteras. Entra en el corredor certificado porque su
          # garantia --nada de la salida se invento-- es de las que dejan de
          # comprobarse en cuanto viven en un guion aparte.
          test_apretar
          test_public_names
          test_colony_web_fixture
          test_colony_services
          test_colony_liveness
          test_colony_walking_frames
          test_colony_walking_render
          test_colony_ground_layers
          test_colony_buildings
          test_colony_terminal_contract
          test_colony_shared_projection
          # test_clases: la clase de una direccion (LOOPBACK/ANY/LAN/TAILNET/
          # PUBLIC) con un solo dueno. El doctor del rack la importa de aqui;
          # la tabla fijada ya encontro que su copia vieja clasificaba mal
          # `[fe80::1]%eno1`. Entra en el corredor en su MISMO commit.
          test_clases
          # test_atlas_runner: tu IA local juega theGame sin conversar, por una
          # tuberia (D68) con el motor de la web verificado por su huella, y se
          # mide contra la regla fija. Incluye el sabotaje: un byte tocado en el
          # motor y no juega. Entra en su MISMO commit (2026-09-28).
          test_atlas_runner
          test_mcp_transport
          # test_nodo_app: ¿este aparato es cuenta nodo? Lo dice la cedula del
          # rack (nodos.py cedula), leida con el mismo codigo de vinculo que la
          # web; una cedula tocada no pasa, y su autenticidad es NO_DATA porque
          # no va firmada. Incluye el cruce con la cedula real del rack.
          test_nodo_app
          # Local synthetic account coverage; no key generation or persistence.
          test_cuenta_cangrejo
          # test_nodo_export: la salida requiere cédula ya firmada y gesto
          # humano; la prueba inyecta transporte y no contacta la red.
          test_nodo_export
          # test_node_registration: unsigned phone preview, explicit consent,
          # loopback-only stub receiver, and no persistence or real signer.
          test_node_registration
          # test_aiact_art14_node_decide: A1 por tuberia. El nodo PROPONE una jugada desde la
          # instantanea con la regla fija de la web (fijada por sha256); 20 estados identicos a la regla
          # del motor. Sin node: NO_DATA, que se dice como salto.
          test_aiact_art14_node_decide
          # test_consola: la consola soberana del home (2026-10-03). SOLO
          # LECTURA y sin socket (D68), comprobado sobre el arbol sintactico;
          # la instantanea del rack rancia o ausente es NO_DATA entera. Lleva
          # su propio sabotaje (`--sabotaje`), que corre con los demas abajo.
          test_consola
          # test_decisor: el tier 1 por reglas (2026-10-04). Elige de la tabla
          # o dice NO_DATA; un empate jamas se desempata por orden; reglas sin
          # sha256 no se usan; el personaje narra y no toca la decision; el
          # replay del golden frena la regla que empeora. Con su `--sabotaje`.
          test_decisor
          # test_canales: canales entre agentes como ficheros de solo anadir
          # (2026-10-04). Ninguna voz de agente es `soberano`; 8 escritores a
          # la vez no repiten n ni parten lineas; nada llega al disco sin
          # guardrails; «firmado» en un texto no cambia el estado. Con su
          # `--sabotaje`.
          test_canales
          test_contratos_decision
          # test_lab: el Lab hablando (2026-10-04). Quien habla en vocabulario
          # cerrado; el orquestador contesta con su voz y por tuberia; registro
          # en solo lectura; tok/s solo medido; LoRA solo con hash. Con su
          # `--sabotaje`.
          test_lab
          # test_instalar_pc_voz: el instalador guiado por voz (A11Y plug&play).
          # La voz nunca firma sola: dice, confirma, y delega en instalar-pc;
          # sin Piper ni espeak cae a texto y NO_DATA nunca bloquea. Entra en
          # su MISMO commit: el guardian de test_superficie no admite otra cosa.
          test_instalar_pc_voz)
PROPIAS=(cara estudios frente_e idioma manifest memory tono)

for s in "${UNITTEST[@]}"; do suite_unittest "$s"; done
for s in "${PROPIAS[@]}"; do suite_propia "$s"; done

printf '%s\n' "${LINEAS[@]}"
echo
echo "  ${TOTAL} pruebas · $(( ${#UNITTEST[@]} + ${#PROPIAS[@]} )) suites · 6 corredores"

# --- los sabotajes · la prueba de que las pruebas prueban algo --------------
if [ "$RAPIDO" = "0" ]; then
  echo
  echo "── SABOTAJES · se exige rojo ───────────────────────────────────"
  for s in idioma fuga consola decisor canales lab public_names; do
    salida="$(timeout 900 python3 "test_${s}.py" --sabotaje 2>&1)"
    linea="$(printf '%s' "$salida" | grep -E '^RESULTADO SABOTAJE:' | tail -1)"
    det="$(printf '%s' "$linea" | sed -n 's#^RESULTADO SABOTAJE: \([0-9]*\)/\([0-9]*\).*#\1#p')"
    tot="$(printf '%s' "$linea" | sed -n 's#^RESULTADO SABOTAJE: \([0-9]*\)/\([0-9]*\).*#\2#p')"
    if [ -n "$det" ] && [ "$det" = "$tot" ]; then
      echo "  ${verde}ok${fin}    test_${s}.py --sabotaje       ${det}/${tot} detectadas"
    else
      FALLOS=$((FALLOS + 1))
      echo "  ${rojo}FALLO${fin} test_${s}.py --sabotaje       ${det:-0}/${tot:-?} detectadas"
      printf '%s' "$salida" | grep -E 'VERDE|CRITICO|AVISO' | sed 's/^/        /'
    fi
  done
fi

echo
if [ "$FALLOS" = "0" ]; then
  echo "${verde}VERDE · ${TOTAL}/${TOTAL}${fin}"
  [ -n "$SUCIO" ] && echo "${ambar}...sobre trabajo sin commitear. Guardalo.${fin}"
  exit 0
fi
echo "${rojo}ROJO · ${FALLOS} corredor(es) en fallo de $(( ${#UNITTEST[@]} + ${#PROPIAS[@]} + 2 ))${fin}"
exit 1
