a */
      npc_chunk: true,
      npc_escala: 0.25,
      /* Estela (MOVIMIENTO 1-2): longitud maxima */
      estela_max: 8,
      /* Burbujas por calidad (MOVIMIENTO 4): mar respira */
      burbujas_por_calidad: [0, 2, 5]
    },
    /* M17-bis 5 (firma F-A, 2026-10-10): LA TABLA DE DERIVADOS SEMANTICOS. Cada parametro visual y
