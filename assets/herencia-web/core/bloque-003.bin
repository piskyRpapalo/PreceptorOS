 1 - ins.integridad / ins.integridad_max;
  }

  var ctx = null, activo = false;
  function activa(si) {
    activo = !!si;
    if (activo && !ctx) {
      var C = raiz.AudioContext || raiz.webkitAudioContext;
      if (!C) { activo = false; return false; }
      ctx = new C();
    }
    if (ctx && ctx.state === 'suspended') { ctx.resume(); }
    return activo;
  }

