ng:.4rem .45rem;position:relative;font:.72rem/1 var(--mono);color:var(--text-muted);text-decoration:none;border-radius:var(--radius)}
.cab-lenguas a::before{content:"";position:absolute;inset:-10px -8px}
.cab-lenguas a[aria-current]{color:var(--text-main);background:var(--bg-secondary)}
/* base.css pone main{max-width:46rem} para las paginas de lectura; el juego quiere todo el ancho. */
main.juego-panel{max-width:none;width:auto;margin:0;padding:0;background:none;border:0;box-shadow:none;border-radius:0;min-height:calc(100dvh - 3.2rem)}
.juego-carga{margin:0;padding:2rem clamp(.75rem,2vw,1.5rem);font:.9rem/1.5 var(--mono);color:var(--text-muted)}
.juego-panel .thegame-capa{position:relative;inset:auto;z-index:auto;width:auto;height:auto;min-height:inherit;overflow:visible;padding:0}
.juego-panel .thegame-juego{max-width:none}
.juego-panel .thegame-t{display:none}
