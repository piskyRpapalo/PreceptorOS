{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:preceptoros:orquestador-respuesta:1",
  "title": "App orchestrator response with deterministic speech",
  "type": "object",
  "additionalProperties": false,
  "required": ["esquema", "intent", "estado", "causa", "motivo", "habla"],
  "properties": {
    "esquema": {"const": "preceptoros.orquestador/1"},
    "intent": {"enum": ["DEPLOY_BUILDING", "QUERY_STATE", "UPDATE_RAG"]},
    "estado": {"enum": ["PROPOSED", "MEASURED", "STALE", "NO_DATA"]},
    "causa": {"type": ["string", "null"]},
    "motivo": {"type": "string", "pattern": "^[a-z_]+$"},
    "habla": {"type": "string", "maxLength": 80},
    "requiere": {"type": "string"},
    "efecto": {"type": "string"},
    "manifiesto": {"$ref": "urn:preceptoros:edificio:1"},
    "origen": {"type": "string"},
    "respuesta": {"type": "string"},
    "fuentes": {"type": "integer", "minimum": 1, "maximum": 50},
    "tokens_rag_aprox": {"type": "integer", "minimum": 0, "maximum": 1200},
    "rag_completo": {"type": "boolean"},
    "dato": {}
  },
  "oneOf": [
    {"properties": {"intent": {"const": "DEPLOY_BUILDING"}, "estado": {"const": "PROPOSED"}, "motivo": {"const": "deploy_signature_required"}, "habla": {"const": "Despliegue propuesto. Requiere FIRMO."}}},
    {"properties": {"intent": {"const": "DEPLOY_BUILDING"}, "estado": {"const": "NO_DATA"}, "motivo": {"const": "deploy_rejected"}, "habla": {"const": "Despliegue no disponible. Consulte la causa."}}},
    {"properties": {"intent": {"const": "QUERY_STATE"}, "estado": {"const": "MEASURED"}, "motivo": {"const": "query_source_measured"}, "habla": {"const": "Consulta respondida con una fuente medida."}}},
    {"properties": {"intent": {"const": "QUERY_STATE"}, "estado": {"const": "STALE"}, "motivo": {"const": "query_source_stale"}, "habla": {"const": "El estado procede de una fuente caducada."}}},
    {"properties": {"intent": {"const": "QUERY_STATE"}, "estado": {"const": "NO_DATA"}, "motivo": {"const": "query_source_unavailable"}, "habla": {"const": "Consulta sin datos. Consulte la causa."}}},
    {"properties": {"intent": {"const": "UPDATE_RAG"}, "estado": {"const": "NO_DATA"}, "motivo": {"const": "chat_write_forbidden"}, "habla": {"const": "Actualización bloqueada desde el chat."}}}
  ]
}
