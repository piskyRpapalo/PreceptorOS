{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hilo",
    "texto",
    "rol",
    "sello",
    "maquina"
  ],
  "x-max-utf8-exclusive": 1024,
  "properties": {
    "hilo": {
      "enum": [
        "app",
        "web",
        "lab",
        "orquesta"
      ]
    },
    "texto": {
      "type": "string",
      "minLength": 1
    },
    "rol": {
      "type": "string",
      "maxLength": 120
    },
    "sello": {
      "$ref": "aiact_art12_sellos.json#/$defs/canal"
    },
    "maquina": {
      "type": "object"
    }
  }
}
